{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping green_sarc_* metrics.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "tags": ["green-sarc", "finops", "greenops"],
  "title": "Green SARC — governance",
  "uid": "green-sarc",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Gate admit / reject rate (per second)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(green_sarc_gate_admitted_total[5m])",
          "legendFormat": "admitted"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(green_sarc_gate_rejected_total[5m]))",
          "legendFormat": "rejected: {{reason}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Budget burn-down (tokens / USD remaining)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "green_sarc_budget_tokens_remaining",
          "legendFormat": "tokens remaining"
        },
        {
          "refId": "B",
          "expr": "green_sarc_budget_usd_remaining",
          "legendFormat": "USD remaining"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Carbon ceiling remaining (gCO2e)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "green_sarc_carbon_remaining_g",
          "legendFormat": "gCO2e remaining"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Forecast error — mean |actual - predicted| tokens",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Rate of histogram sum / count = rolling mean absolute forecast error. (Proper WAPE needs an actuals counter; see docs/metrics.md.)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(green_sarc_forecast_abs_error_tokens_sum[5m]) / rate(green_sarc_forecast_abs_error_tokens_count[5m])",
          "legendFormat": "mean abs error (tokens)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Circuit-breaker trips & escalations (per second)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(green_sarc_breaker_trips_total[5m])",
          "legendFormat": "breaker trips"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(green_sarc_escalations_total[5m]))",
          "legendFormat": "escalation: {{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Gate decision latency (p50 / p99)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(green_sarc_gate_decision_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(green_sarc_gate_decision_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
